{
  "consumer": {
    "name": "order-service"
  },
  "interactions": [
    {
      "description": "a discount request for a category and quantity",
      "providerStates": [
        {
          "name": "a volume discount exists for ELECTRONICS"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/api/v1/discounts",
        "query": {
          "category": [
            "ELECTRONICS"
          ],
          "quantity": [
            "3"
          ]
        }
      },
      "response": {
        "body": {
          "category": "ELECTRONICS",
          "percentage": 5.0,
          "quantity": 3
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.percentage": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "decimal"
                }
              ]
            },
            "$.quantity": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "a price request for an existing product",
      "providerStates": [
        {
          "name": "product SKU-001 exists"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/api/v1/products/SKU-001/price"
      },
      "response": {
        "body": {
          "category": "ELECTRONICS",
          "currency": "USD",
          "sku": "SKU-001",
          "unitPrice": 120.0
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.category": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.currency": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "[A-Z]{3}"
                }
              ]
            },
            "$.unitPrice": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "decimal"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "a stock request for an existing product",
      "providerStates": [
        {
          "name": "product SKU-001 exists"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/api/v1/products/SKU-001/stock"
      },
      "response": {
        "body": {
          "available": 50,
          "sku": "SKU-001"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.available": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "a price request for an unknown product",
      "providerStates": [
        {
          "name": "product SKU-404 does not exist"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/api/v1/products/SKU-404/price"
      },
      "response": {
        "status": 404
      }
    }
  ],
  "metadata": {
    "pact-jvm": {
      "version": "4.6.21"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "catalog-service"
  }
}
